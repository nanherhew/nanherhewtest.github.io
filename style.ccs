/* NANHER HEW 文 — ZINE / POP-BRUTALIST */
:root{
  --paper:#f3ede0; --paper2:#e9e1d0; --ink:#15121a; --muted:#6b6470;
  --accent:#ff5a1f; --lilac:#b9a6ff; --lime:#d6ff3d; --pink:#ff8fc7;
  --f-display:"Bricolage Grotesque",sans-serif; --f-mono:"DM Mono",monospace; --f-kanji:"Noto Serif SC",serif;
  --bd:2px solid var(--ink); --sh:5px 5px 0 var(--ink);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--f-mono);font-size:14px;line-height:1.7;overflow-x:hidden;
  background-image:radial-gradient(rgba(21,18,26,.12) 1px,transparent 1px);background-size:22px 22px}
img{display:block;width:100%}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;cursor:pointer}
section{padding:110px 6vw;position:relative}
mark{background:var(--lime);color:var(--ink);padding:0 .12em;box-decoration-break:clone;-webkit-box-decoration-break:clone}
h1,h2,h3{font-family:var(--f-display);font-weight:800;line-height:.92;letter-spacing:-.04em}
h2{font-size:clamp(42px,7vw,100px)}
em{font-style:normal;color:var(--accent)}

/* UI atoms */
.chip{display:inline-flex;align-items:center;gap:8px;padding:5px 12px;border:var(--bd);border-radius:99px;background:var(--paper);font-size:11px;font-weight:500;letter-spacing:.08em}
.chip-ink{background:var(--ink);color:var(--paper)}.chip-lime{background:var(--lime)}.chip-lilac{background:var(--lilac)}.chip-accent{background:var(--accent)}
.pulse{width:8px;height:8px;border-radius:50%;background:var(--ink);animation:pulse 1.4s infinite}
@keyframes pulse{50%{transform:scale(1.8);opacity:.3}}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:14px 22px;border:var(--bd);border-radius:14px;background:var(--paper);box-shadow:var(--sh);font-size:12px;font-weight:500;letter-spacing:.08em;transition:transform .15s,box-shadow .15s,background .15s}
.btn:hover{transform:translate(3px,3px);box-shadow:2px 2px 0 var(--ink)}
.btn:active{transform:translate(5px,5px);box-shadow:0 0 0 var(--ink)}
.btn-accent{background:var(--accent)}.btn-ink{background:var(--ink);color:var(--paper);box-shadow:5px 5px 0 var(--accent)}
.btn.wide{width:100%;margin-top:20px}.btn.small{padding:8px 12px;font-size:10px;box-shadow:3px 3px 0 var(--ink)}.btn.big{padding:20px 30px;font-size:15px}
.btn:disabled{opacity:.45;cursor:not-allowed;box-shadow:none}
.x{position:absolute;top:14px;right:18px;border:0;background:none;font-size:34px;line-height:1;z-index:3}.x:hover{color:var(--accent);transform:rotate(90deg)}
.sec-head{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:60px;flex-wrap:wrap}
.sec-head p{max-width:300px;color:var(--muted);font-size:12px}

/* Age gate */
.gate{position:fixed;inset:0;z-index:99999;display:grid;place-items:center;padding:20px;background:rgba(21,18,26,.7);backdrop-filter:blur(14px);transition:opacity .4s,visibility .4s}
.gate.hidden{opacity:0;visibility:hidden;pointer-events:none}
.gate-card{width:min(440px,100%);background:var(--paper);border:var(--bd);border-radius:22px;box-shadow:8px 8px 0 var(--accent);overflow:hidden;text-align:center;animation:pop .5s cubic-bezier(.2,1.4,.4,1)}
@keyframes pop{from{transform:scale(.85) rotate(-3deg);opacity:0}}
.gate-banner{height:130px;object-fit:cover;border-bottom:var(--bd);background:var(--lilac)}
.gate-body{padding:26px 28px 30px}
.gate-kanji{font-family:var(--f-kanji);font-size:54px;line-height:1;color:var(--accent)}
.gate h2{font-size:34px;margin:14px 0 10px}.gate p{font-size:12px;color:var(--muted);margin-bottom:22px}
.gate-btns{display:flex;gap:12px}.gate-btns .btn{flex:1}

/* Nav */
.nav{position:fixed;top:14px;left:50%;transform:translateX(-50%);width:min(1180px,calc(100% - 28px));z-index:1000;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:10px 12px 10px 20px;background:rgba(243,237,224,.9);backdrop-filter:blur(10px);border:var(--bd);border-radius:99px;box-shadow:4px 4px 0 var(--ink)}
.logo{font-family:var(--f-display);font-weight:800;font-size:18px;letter-spacing:-.04em;white-space:nowrap}
.logo b{color:var(--accent)}.logo i{font-style:normal;font-family:var(--f-kanji);margin-left:4px}
.nav nav{display:flex;gap:4px}
.nav nav a{padding:6px 12px;border-radius:99px;font-size:11px;letter-spacing:.06em;transition:background .2s}
.nav nav a:hover{background:var(--lilac)}

/* Hero */
.hero{min-height:100vh;padding-top:150px;display:grid;grid-template-columns:1.05fr 1fr;align-items:center;gap:30px;overflow:hidden;--px:0px;--py:0px}
.hero-kanji{position:absolute;left:-3vw;bottom:-8vw;font-family:var(--f-kanji);font-size:52vw;line-height:.8;color:var(--paper2);z-index:0;user-select:none;translate:calc(var(--px)*1.6) calc(var(--py)*1.6)}
.hero-text,.hero-art{position:relative;z-index:2}
.hero h1{font-size:clamp(80px,14vw,210px);margin:22px 0 28px;position:relative}
.hero h1 em{-webkit-text-stroke:3px var(--ink);color:var(--lime);paint-order:stroke fill;text-shadow:6px 6px 0 var(--ink)}
.star{position:absolute;font-size:.35em;color:var(--accent);top:4%;right:2%;animation:spin 12s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.hero p{max-width:430px;color:var(--muted);margin-bottom:34px}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap}
.hero-art{translate:calc(var(--px)*-.8) calc(var(--py)*-.8);transition:translate .2s ease-out}
.hero-art img{border:var(--bd);border-radius:28px;box-shadow:12px 12px 0 var(--accent);background:var(--lilac);transform:rotate(2.5deg)}
.sticker{position:absolute;z-index:3;padding:10px 18px;border:var(--bd);border-radius:99px;font-family:var(--f-display);font-weight:800;font-size:18px;box-shadow:var(--sh);animation:float 4s ease-in-out infinite}
.s1{top:-12px;left:-10px;background:var(--lime);transform:rotate(-8deg)}.s2{bottom:30px;right:-6px;background:var(--pink);transform:rotate(6deg);animation-delay:-2s}
@keyframes float{50%{translate:0 -10px}}

/* Marquee */
.marquee{overflow:hidden;background:var(--ink);color:var(--paper);border-block:var(--bd);transform:rotate(-1.2deg);margin:10px -2vw;padding:16px 0;position:relative;z-index:3}
.track{display:flex;width:max-content;animation:slide 28s linear infinite;font-family:var(--f-display);font-weight:800;font-size:28px;letter-spacing:-.02em;white-space:nowrap}
@keyframes slide{to{transform:translateX(-50%)}}

/* About */
.about{display:grid;grid-template-columns:.8fr 1.2fr;gap:6vw;align-items:center}
.about-card{position:relative;aspect-ratio:1;display:grid;place-items:center;background:var(--lilac);border:var(--bd);border-radius:28px;box-shadow:10px 10px 0 var(--ink);transform:rotate(-3deg)}
.about-kanji{font-family:var(--f-kanji);font-size:clamp(140px,22vw,320px);line-height:1;color:var(--paper)}
.about-card small{position:absolute;left:18px;bottom:14px;font-size:11px}
.about h2{margin:20px 0 28px}.about p{max-width:560px;margin-bottom:16px}
.facts{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}
.facts div{padding:12px 20px;border:var(--bd);border-radius:16px;background:var(--paper);box-shadow:4px 4px 0 var(--ink)}
.facts span{display:block;font-size:10px;color:var(--muted);letter-spacing:.1em}.facts b{font-family:var(--f-display);font-size:18px}

/* Bento */
.work{background:var(--accent);border-block:var(--bd)}
.work mark{background:var(--ink);color:var(--lime)}
.work .sec-head p{color:var(--ink)}
.bento{display:grid;grid-template-columns:1.3fr .7fr;gap:22px}
.art-card{position:relative;overflow:hidden;border:var(--bd);border-radius:22px;background:var(--paper);box-shadow:var(--sh);cursor:zoom-in;transition:transform .25s,box-shadow .25s}
.art-card:hover{transform:translate(-3px,-3px) rotate(-.4deg);box-shadow:9px 9px 0 var(--ink)}
.art-card img{height:100%;object-fit:cover;transition:transform .6s}.art-card:hover img{transform:scale(1.05)}
.b1{grid-row:span 2;min-height:700px}.b2,.b3{min-height:320px}.b4{grid-column:1/-1;min-height:360px}
.bento figcaption{position:absolute;left:14px;bottom:14px;display:flex;gap:10px;padding:6px 14px;border:var(--bd);border-radius:99px;background:var(--paper);font-size:11px;font-weight:500}
.bento figcaption i{font-style:normal;color:var(--accent)}

/* Archive */
.tabs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:40px}
.tab{padding:10px 18px;border:var(--bd);border-radius:99px;background:var(--paper);font-size:11px;letter-spacing:.08em;transition:.15s}
.tab:hover{background:var(--lilac)}.tab.active{background:var(--ink);color:var(--lime);box-shadow:3px 3px 0 var(--accent)}
.masonry{columns:3 280px;column-gap:20px}
.masonry .art-card{break-inside:avoid;margin-bottom:20px;animation:pop .45s both}
.masonry .art-card img{height:auto}
.masonry .art-card span{display:block;padding:10px 14px;border-top:var(--bd);font-size:10px;letter-spacing:.1em;background:var(--paper)}

/* Comm status */
.status{background:var(--paper2);border-block:var(--bd)}
.legend{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-bottom:40px}
.legend div{padding:16px;border:var(--bd);border-radius:16px;background:var(--paper);box-shadow:4px 4px 0 var(--ink)}
.legend b{display:block;font-size:11px;letter-spacing:.1em;margin-top:8px}.legend small{font-size:11px;color:var(--muted);line-height:1.4;display:block}
.dot{display:block;width:14px;height:14px;border:var(--bd);border-radius:50%}
.blue{background:#2f80ff}.red{background:#ff3b30}.yellow{background:#ffd60a}.green{background:#30d158}.orange{background:var(--accent)}
.tabs.two .tab{flex:1;border-radius:14px;padding:16px}
.spanel{display:none}.spanel.active{display:block}
.finished-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.fcard{border:var(--bd);border-radius:20px;overflow:hidden;background:var(--paper);box-shadow:var(--sh);transition:transform .2s}
.fcard:hover{transform:translateY(-5px) rotate(-.6deg)}
.fimg{position:relative;aspect-ratio:1;background:var(--lilac);display:grid;place-items:center;font-size:12px}
.fimg img{height:100%;object-fit:cover}
.fnum{position:absolute;top:12px;left:12px;padding:3px 10px;background:var(--ink);color:var(--lime);border-radius:99px;font-size:10px}
.finfo{padding:14px 16px;border-top:var(--bd);display:flex;justify-content:space-between;gap:10px;font-size:11px}
.finfo span{color:var(--muted)}.finfo strong{font-weight:500}
.progress-list{display:grid;gap:16px}
.pitem{display:grid;grid-template-columns:90px 1fr auto;gap:20px;align-items:center;padding:12px;border:var(--bd);border-radius:18px;background:var(--paper);box-shadow:4px 4px 0 var(--ink)}
.pimg{width:90px;height:90px;border:var(--bd);border-radius:12px;overflow:hidden;display:grid;place-items:center;font-size:9px;background:var(--lilac);text-align:center}
.pimg img{height:100%;object-fit:cover}
.pmain{display:flex;align-items:center;gap:16px}
.pbar{width:60px;height:10px;border:var(--bd);border-radius:99px;flex-shrink:0}
.pmain strong{display:block;font-family:var(--f-display);font-size:20px;letter-spacing:-.02em}
.pmain span,.pcode{font-size:10px;color:var(--muted);letter-spacing:.1em}
.empty{padding:50px;text-align:center;border:2px dashed var(--ink);border-radius:20px;font-size:12px;color:var(--muted)}

/* Commissions */
.commissions{display:grid;grid-template-columns:1fr 1fr;gap:6vw;align-items:start}
.comm-intro{position:sticky;top:110px}
.comm-intro h2{margin:22px 0 36px}
.prices{display:grid;gap:14px}
.price{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:18px 22px;border:var(--bd);border-radius:18px;background:var(--paper);box-shadow:4px 4px 0 var(--ink);transition:.15s}
.price:hover{transform:translateX(6px);background:var(--lime)}
.price.hot{background:var(--lilac)}
.price b{font-family:var(--f-display);font-size:22px;letter-spacing:-.03em;display:block}
.price small{font-size:11px;color:var(--muted)}.price strong{font-family:var(--f-display);font-size:38px;letter-spacing:-.05em}
.extras{padding:22px;border:2px dashed var(--ink);border-radius:18px;margin-top:10px}
.extras p{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px dashed var(--muted)}.extras p:last-child{border:0}
.extras .chip{margin-bottom:10px}.extras b{color:var(--accent)}

/* Contact */
.contact{background:var(--ink);color:var(--paper);overflow:hidden;min-height:700px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}
.contact>*{position:relative;z-index:2}
.contact-bg{position:absolute!important;z-index:0!important;left:-2vw;bottom:-5vw;font-family:var(--f-display);font-weight:800;font-size:28vw;line-height:.75;color:transparent;-webkit-text-stroke:2px #2c2733;pointer-events:none}
.contact h2{font-size:clamp(80px,15vw,230px);margin:24px 0}
.contact h2 em{color:var(--lime)}
.contact p{max-width:440px;color:#b9b2c2;margin-bottom:34px}
.contact .btn{color:var(--ink);box-shadow:6px 6px 0 var(--lime)}
.socials{display:flex;flex-wrap:wrap;gap:12px;margin-top:44px}
.socials a{padding:8px 16px;border:2px solid #4a4455;border-radius:99px;font-size:11px;letter-spacing:.08em;transition:.2s}
.socials a:hover{background:var(--lime);color:var(--ink);border-color:var(--lime)}
footer{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:26px 6vw;border-top:var(--bd);font-size:11px;letter-spacing:.1em;background:var(--lime)}

/* Lightbox */
.lightbox{position:fixed;inset:0;z-index:9998;display:grid;place-items:center;padding:5vw;background:rgba(21,18,26,.94);opacity:0;visibility:hidden;transition:.25s}
.lightbox.open{opacity:1;visibility:visible}
.lightbox .x{color:var(--paper);top:22px;right:28px}
.lightbox img{max-width:92vw;max-height:88vh;width:auto;border:var(--bd);border-radius:14px;box-shadow:8px 8px 0 var(--accent)}

/* Modals */
.modal{position:fixed;inset:0;z-index:99998;display:grid;place-items:center;padding:20px;opacity:0;visibility:hidden;transition:.3s}
.modal.open{opacity:1;visibility:visible}#termsModal{z-index:100000}
.modal-bg{position:absolute;inset:0;background:rgba(21,18,26,.75);backdrop-filter:blur(12px)}
.panel{position:relative;z-index:2;width:min(620px,100%);max-height:90vh;overflow-y:auto;padding:38px;background:var(--paper);border:var(--bd);border-radius:24px;box-shadow:8px 8px 0 var(--accent);transform:translateY(30px) rotate(-1deg);transition:transform .35s cubic-bezier(.2,1.2,.4,1)}
.modal.open .panel{transform:none}
.panel h2{font-size:clamp(34px,6vw,54px);margin:18px 0 10px}
.modal-intro{color:var(--muted);font-size:12px;margin-bottom:28px}
.field{margin-bottom:20px}
.field>label{display:block;margin-bottom:8px;font-size:10px;letter-spacing:.12em;color:var(--muted)}
.field input,.field textarea,.field select{width:100%;padding:13px 14px;border:var(--bd);border-radius:12px;background:#fff8;color:var(--ink);font:inherit;font-size:13px;outline:none;transition:.2s}
.field input:focus,.field textarea:focus,.field select:focus{background:#fff;box-shadow:4px 4px 0 var(--lilac)}
.field textarea{resize:vertical;min-height:110px}
.methods{display:flex;flex-wrap:wrap;gap:8px}
.methods label{position:relative}.methods input{position:absolute;opacity:0}
.methods span{display:block;padding:8px 14px;border:var(--bd);border-radius:99px;font-size:10px;letter-spacing:.06em;transition:.15s}
.methods span:hover{background:var(--lilac)}.methods input:checked+span{background:var(--ink);color:var(--lime)}
.terms-check{display:flex;gap:12px;align-items:flex-start;margin-top:26px;padding-top:20px;border-top:2px dashed var(--ink);font-size:11px;font-weight:500;cursor:pointer}
.terms-check input{position:absolute;opacity:0}
.box{flex-shrink:0;width:22px;height:22px;border:var(--bd);border-radius:6px;background:#fff;display:grid;place-items:center}
.terms-check input:checked+.box{background:var(--lime)}.terms-check input:checked+.box::after{content:"✓";font-weight:700}
.link{border:0;background:none;text-decoration:underline;color:var(--accent);font:inherit;font-weight:700}
.success{display:none;text-align:center;padding:30px 0}.success.show{display:block}
.check{width:70px;height:70px;margin:0 auto 24px;display:grid;place-items:center;background:var(--lime);border:var(--bd);border-radius:50%;font-size:30px;box-shadow:var(--sh)}
.success h3{font-size:60px;margin-bottom:16px}.success p{max-width:340px;margin:0 auto 26px;color:var(--muted)}
.terms-top{display:flex;justify-content:space-between;align-items:center;gap:14px;padding-right:34px;flex-wrap:wrap}
.tsec{padding:18px 0;border-top:2px dashed var(--ink)}
.tsec h3{font-family:var(--f-mono);font-size:11px;letter-spacing:.14em;color:var(--accent);margin-bottom:8px}
.tsec p{font-size:12px;color:#4a444f}

/* Responsive */
@media(max-width:900px){
  .nav nav,.nav .chip{display:none}.nav{justify-content:center}
  .hero,.about,.commissions{grid-template-columns:1fr}
  .hero{padding-top:130px}.hero-art{max-width:440px;margin:0 auto}
  .about-card{max-width:340px}
  .bento{grid-template-columns:1fr}.b1{grid-row:auto;min-height:480px}.b4{grid-column:auto}
  .legend{grid-template-columns:repeat(2,1fr)}.finished-grid{grid-template-columns:repeat(2,1fr)}
  .comm-intro{position:static}
}
@media(max-width:600px){
  section{padding:80px 5vw}
  .legend,.finished-grid{grid-template-columns:1fr}
  .pitem{grid-template-columns:70px 1fr}.pimg{width:70px;height:70px}.pcode{grid-column:2}
  .panel{padding:30px 20px}.price strong{font-size:30px}.track{font-size:20px}
  .gate-btns{flex-direction:column}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
